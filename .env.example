# Local dev only — copy to .env (gitignored) and adjust if needed.
# Matches docker-compose.yml's postgres/azurite services.

PORT=3000

# App runtime connection — non-superuser role, so Postgres RLS actually
# applies to it (see drizzle/0002_app_runtime_role.sql for why this can't
# just be the jobsearch/superuser role).
DATABASE_URL=postgresql://app_user:localdev_app@localhost:5433/job_search_ai

# Migrations only (db:migrate) — needs CREATE TABLE/ROLE/POLICY privileges
# the app_user role deliberately doesn't have.
MIGRATION_DATABASE_URL=postgresql://jobsearch:localdev@localhost:5433/job_search_ai

# The documented shorthand for the storage emulator. It expands, inside the SDK,
# to the same fixed account and key every Azurite installation uses — so writing
# that key out here would add nothing except a credential-shaped string in the
# repository, which secret scanners flag forever and which teaches the eye to
# accept such strings in example files. Verified against a running Azurite: it
# parses, and a container round-trips through it.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Background jobs run on pg-boss inside the same Postgres (own schema, "pgboss")
# — no separate service or connection string. It reuses DATABASE_URL above,
# connecting as app_user with `migrate: false`: the schema, its tables and
# every queue are provisioned by migrations (0015-0017), never by the
# runtime connection, which has no CREATE rights (T20).

# Anthropic API key for the LLM layer (T9) — create at console.anthropic.com,
# personal account. Real secret: set in .env only, never commit.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key, embeddings only (retrieval infrastructure) — Anthropic has
# no embeddings API. Create at platform.openai.com. Real secret: set in .env
# only, never commit.
OPENAI_API_KEY=sk-your-key-here

# Monthly per-user LLM budget cap in USD (NFR2, hard block). Non-secret
# config; defaults to 10 if unset.
LLM_MONTHLY_BUDGET_USD=10

# Worst-case cost ceiling for a SINGLE attempt, checked before the request is
# sent (max_tokens x output price + prompt). Catches one runaway call that the
# monthly cap would only notice afterwards. Defaults to 0.5 if unset.
LLM_MAX_ATTEMPT_COST_USD=0.5

# --- Auth (T12) -------------------------------------------------------------

# Where this API is reachable — used to build the OAuth redirect URI, which
# must match the one registered with Google exactly.
APP_BASE_URL=http://localhost:3000

# Serve the Swagger explorer at /api. It is unauthenticated and describes every
# endpoint, so it is off unless switched on. With no UI in the MVP this is how
# the system is driven locally — keep it true here, leave it unset when deployed.
ENABLE_SWAGGER=true

# Google OAuth client (Web application) from console.cloud.google.com.
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs the session cookie. Any long random string; changing it invalidates
# every existing session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-me

# Who may have an account here. Comma-separated `provider:subject` entries,
# where subject is the provider's immutable id (Google `sub`) — never an email.
#
# EMPTY OR UNSET MEANS NOBODY IS ADMITTED. That is deliberate: signing in with a
# valid Google account is not permission to use this system, and each account
# can spend up to the monthly LLM cap. Failing closed makes a forgotten variable
# obvious (nobody can sign in) rather than expensive (anybody can).
#
# To find your own subject: attempt sign-in with this left as-is — the refusal
# is logged server-side with the exact `provider:subject` to add here.
AUTH_ALLOWED_SUBJECTS=google:your-google-sub
