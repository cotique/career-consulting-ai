{
  "name": "career-consulting-ai",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:local": "nest build && node --env-file=.env dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env -r tsx/cjs src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.33.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "mammoth": "^1.12.1",
    "openid-client": "^6.8.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.15.47",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.0"
  }
}
