# Local Claude Code tool-permission state — machine-specific, not project config.
.claude/settings.local.json

# Tooling mirrors of .claude/skills and .claude/hooks — regenerated by other
# agent tools, not a source of truth. The originals live in .claude/ and are
# tracked. `.codex/` is ignored rather than merely deleted because a reinstall
# recreates it, and a second copy of the branch-protection hook is worse than
# none: two mechanisms for one rule, silently diverging.
.agents/
.codex/

# Per-machine measurement and session state, not shared: two machines sharing
# one event journal would mix the numbers of what is meant to be one instrument
# per machine.
.claude/discipline-events.jsonl
.claude/session-state.json
